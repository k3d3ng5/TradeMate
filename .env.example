# Create a bot with Telegram's free BotFather service, then paste its token here.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token

# Your Telegram numeric user ID(s), separated by commas. Example: 123456789
TELEGRAM_ALLOWED_USER_IDS=replace_with_your_telegram_user_id

# Keep false for normal use. Only set true for local setup when you have no ID yet.
# In development mode, anyone who can message the bot may use it.
TRADEMATE_DEV_MODE=false

# Market prices: mt5 (default) or binance. MT5 needs its desktop terminal open.
TRADEMATE_MARKET_SOURCE=mt5

# Standalone PWA owner account. Required when running `python -m trademate.web`.
# Use a strong, unique password and keep this file private.
TRADEMATE_ADMIN_EMAIL=you@example.com
TRADEMATE_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
TRADEMATE_DB_PATH=trademate.sqlite3
# Keep true on an HTTPS deployment. Set false only for local HTTP testing.
TRADEMATE_COOKIE_SECURE=true

# Neon backend (filled by `neon deploy`). Keep .env private.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
NEON_BRANCH=production
NEON_AUTH_BASE_URL=https://your-neon-auth-host/auth
NEON_AUTH_JWKS_URL=https://your-neon-auth-host/auth/.well-known/jwks.json

