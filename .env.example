# Create a bot with Telegram's free BotFather service, then paste its token here.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token

# Your Telegram numeric user ID(s), separated by commas. Example: 123456789
TELEGRAM_ALLOWED_USER_IDS=replace_with_your_telegram_user_id

# Keep false for normal use. Only set true for local setup when you have no ID yet.
# In development mode, anyone who can message the bot may use it.
TRADEMATE_DEV_MODE=false

# Market prices: mt5 (default) or binance. MT5 needs its desktop terminal open.
TRADEMATE_MARKET_SOURCE=mt5

